.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git
.git
.gitignore
.gitattributes

# CI/CD (já está na Vercel)
.github
.gitlab-ci.yml

# Documentation (não necessário no deploy)
*.md
!README.md

# Scripts de desenvolvimento
scripts/seed*.ts
scripts/test*.ts

