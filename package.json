{
  "name": "xproducoes-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "generate:sitemap": "tsx scripts/generateSitemap.ts",
    "prebuild": "npm run generate:sitemap",
    "build": "tsc && vike build",
    "build:analyze": "tsc && vite build --mode analyze",
    "server": "node server",
    "preview": "npm run build && npm run server",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "snyk:test": "snyk test || true",
    "type-check": "tsc --noEmit",
    "seed": "ts-node --esm src/services/seedBackend.ts",
    "optimize:images": "node scripts/imageOptimization.js analyze",
    "analyze:bundle": "node scripts/performanceAnalysis.js"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@lottiefiles/dotlottie-react": "^0.17.13",
    "@react-oauth/google": "^0.13.4",
    "@sentry/react": "^10.19.0",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.4.0",
    "clsx": "^2.0.0",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "framer-motion": "^12.35.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.563.0",
    "react": "19.2.0",
    "react-big-calendar": "^1.19.4",
    "react-dom": "19.2.0",
    "react-ga4": "^2.1.0",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.45.2",
    "react-is": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.0.18",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.1.2",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.4.0",
    "vike": "^0.4.253",
    "vike-react": "^0.6.20",
    "xlsx-js-style": "^1.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.50.0",
    "@rollup/plugin-alias": "^6.0.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^25.2.1",
    "@types/react": "19.2.0",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "19.2.0",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.16",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.3.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^28.0.0",
    "playwright": "^1.50.0",
    "postcss": "^8.4.32",
    "rollup-plugin-visualizer": "^6.0.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "terser": "^5.44.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.0.2",
    "typescript-eslint": "^8.54.0",
    "uuid": "^13.0.0",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.0.3",
    "vite-tsconfig-paths": "^6.1.0",
    "vitest": "^4.0.18",
    "workbox-window": "^7.0.0"
  },
  "engines": {
    "node": "20.x"
  }
}
