# Exemplo de configuração de variáveis de ambiente para o frontend
# Copie este arquivo para .env e preencha com suas credenciais reais

# URL da API do backend (local ou produção)
VITE_API_URL=http://localhost:4000

# Base da API (opcional)
VITE_API_BASE_URL=http://localhost:4000/api

# Timeout da API
VITE_API_TIMEOUT=30000

# Social Auth
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here
VITE_FACEBOOK_APP_ID=your-facebook-app-id-here

# Ambiente
VITE_NODE_ENV=development

# WhatsApp
VITE_WHATSAPP_PHONE=+5531975808477
